# Copia este fichero a runtime.env. El fichero real está ignorado por Git.

# Imágenes y acceso al gateway
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.9.2
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_HOST=127.0.0.1
OPENCLAW_GATEWAY_PORT=18789

# Proxmox MCP: usa un usuario/token dedicado con PVEAuditor y privsep=1.
PROXMOX_HOST=
PROXMOX_PORT=8006
PROXMOX_USER=mcp@pve
PROXMOX_TOKEN_NAME=mcp
PROXMOX_TOKEN_VALUE=
PROXMOX_VERIFY_SSL=true

# Programación de las automatizaciones.
AUTOMATION_TZ=Etc/UTC
